{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checkpoint Schema",
  "description": "CRP checkpoint.json의 표준 스키마. 모든 하네스 작업의 진행 상태를 기록한다.",
  "type": "object",
  "required": ["schema_version", "session_id", "harness_name", "status", "current_phase", "total_phases", "phases", "decision_log", "metadata"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "session_id": {
      "type": "string",
      "description": "고유 세션 식별자"
    },
    "harness_name": {
      "type": "string",
      "description": "실행 중인 하네스 이름"
    },
    "purpose_anchor": {
      "type": "string",
      "description": "목적 앵커 파일 경로 (ICIP 연동)"
    },
    "status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "COMPLETED", "PAUSED", "FAILED"]
    },
    "current_phase": {
      "type": "integer",
      "minimum": 0
    },
    "current_step": {
      "type": "integer",
      "minimum": 0
    },
    "total_phases": {
      "type": "integer",
      "minimum": 1
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "name", "status"],
        "properties": {
          "phase": { "type": "integer" },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED", "SKIPPED"]
          },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "completed_at": { "type": ["string", "null"], "format": "date-time" },
          "outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "agents": {
            "type": "object",
            "properties": {
              "completed": { "type": "array", "items": { "type": "string" } },
              "in_progress": { "type": "array", "items": { "type": "string" } },
              "pending": { "type": "array", "items": { "type": "string" } }
            }
          },
          "summary": { "type": "string" }
        }
      }
    },
    "decision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "phase", "decision", "reason"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "phase": { "type": "integer" },
          "decision": { "type": "string" },
          "reason": { "type": "string" },
          "alternatives_considered": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "error_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "phase": { "type": "integer" },
          "error": { "type": "string" },
          "resolution": { "type": "string" },
          "epr_pattern_id": { "type": ["string", "null"] }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["created_at", "last_updated"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "last_updated": { "type": "string", "format": "date-time" },
        "total_elapsed_minutes": { "type": "number" },
        "compaction_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
